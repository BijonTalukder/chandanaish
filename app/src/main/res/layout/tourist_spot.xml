<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="15dp"
    android:padding="5dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Tourist Spot Image -->
        <ImageView
            android:id="@+id/tourist_spot_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/b2" />

        <!-- Title -->
        <TextView
            android:id="@+id/tourist_spot_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tourist Spot Name"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Location -->
        <TextView
            android:id="@+id/tourist_spot_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: City, Country"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tourist_spot_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="A short description of the tourist spot..."
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- More Details Button -->
        <Button
            android:id="@+id/tourist_spot_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="View More"
            android:textAllCaps="false"
            android:backgroundTint="@color/purple_500"
            android:textColor="@android:color/white"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
