<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"

    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/doctordemolist"
        android:layout_width="match_parent"
        android:weightSum="6"
        android:orientation="horizontal"
        android:layout_height="120dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_margin="5dp"
            android:padding="5dp"
            android:layout_height="match_parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/doctorImage"
                android:layout_width="90dp"
                app:shapeAppearanceOverlay="@style/roundedImageViewRounded"
                app:strokeWidth="3dp"
                android:src="@drawable/ic_sharp_how_to_reg_24"


                android:layout_height="90dp"

                />

        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_weight="4"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/doctorName"
                android:layout_width="match_parent"
                android:text="Diioiao"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#3F51B5"
                android:fontFamily="monospace"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/spacalist"
                android:layout_width="match_parent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#252527"
                android:fontFamily="monospace"
                android:text="rtret"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/doctordesignation"
                android:layout_width="match_parent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#252527"
                android:fontFamily="monospace"
                android:text="rtret"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/doctorcember"
                android:layout_width="match_parent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#252527"
                android:fontFamily="monospace"
                android:text="rtret"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/doctorvisitingtime"
                android:layout_width="match_parent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#252527"
                android:fontFamily="monospace"
                android:text="rtret"
                android:layout_height="wrap_content"/>


        </LinearLayout>


    </LinearLayout>

</LinearLayout>