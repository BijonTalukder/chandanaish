<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey"
    android:padding="16dp">


<androidx.cardview.widget.CardView
android:id="@+id/doctordemolist"
android:layout_width="match_parent"
android:layout_height="130dp"
android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="horizontal"
    android:weightSum="10"
android:padding="12dp">


<LinearLayout
    android:layout_width="0dp"
    android:layout_weight="3"
    android:layout_height="match_parent"

    android:layout_gravity="center_vertical"
    android:gravity="center"
    android:padding="5dp">

    <!-- Rounded ImageView -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/doctorImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:shapeAppearanceOverlay="@style/roundedImageViewRounded"
        app:strokeWidth="2dp"
        app:strokeColor="@color/primary_color"
    android:src="@drawable/ic_sharp_how_to_reg_24" />
</LinearLayout>

<!-- Text Details Container -->
<LinearLayout
    android:layout_width="0dp"
        android:layout_weight="5"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="7dp"
    tools:ignore="ExtraText"> <!-- Add padding to separate text from image -->

    <!-- Doctor Name -->
    <TextView
        android:id="@+id/Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dr. John Doe"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary_color"


    />


    <TextView
        android:id="@+id/spacalist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cardiologist"
        android:textSize="14sp"
        android:textColor="@color/secondary_text_color"
    android:layout_marginTop="4dp"
    />


    <TextView
        android:id="@+id/doctordesignation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Senior Consultant"
        android:textSize="12sp"
        android:textColor="@color/secondary_text_color"
        android:fontFamily="sans-serif"
        android:layout_marginTop="4dp" />


    <TextView
        android:id="@+id/doctorNumber"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5 years of experience"
        android:textSize="12sp"
        android:textColor="@color/secondary_text_color"
        android:fontFamily="sans-serif"
        android:layout_marginTop="4dp" />

<!--    <TextView-->
<!--        android:id="@+id/doctorvisitingtime"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="Visiting Hours: 9 AM - 5 PM"-->
<!--        android:textSize="12sp"-->
<!--        android:textColor="@color/secondary_text_color"-->
<!--        android:fontFamily="sans-serif"-->
<!--        android:layout_marginTop="4dp" />-->
</LinearLayout>


    <LinearLayout
        android:id="@+id/callSectionDoctor"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="2dp"
      >
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/callanimationD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_url="https://assets7.lottiefiles.com/packages/lf20_datqo9uz.json" />

    </LinearLayout>

</LinearLayout>
    </androidx.cardview.widget.CardView>
    </LinearLayout>