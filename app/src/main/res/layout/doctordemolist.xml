<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey" <!-- Light background for the entire screen -->
    android:padding="16dp"> <!-- Add padding to the parent layout -->

    <!-- CardView for rounded corners and elevation -->
<androidx.cardview.widget.CardView
android:id="@+id/doctordemolist"
android:layout_width="match_parent"
android:layout_height="130dp"
android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="horizontal"
android:padding="12dp">


<LinearLayout
    android:layout_width="0dp"
    android:layout_weight="2"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center"
    android:padding="8dp">

    <!-- Rounded ImageView -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/doctorImage"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:shapeAppearanceOverlay="@style/roundedImageViewRounded"
        app:strokeWidth="2dp"
        app:strokeColor="@color/primary_color"
    android:src="@drawable/ic_sharp_how_to_reg_24" />
</LinearLayout>

<!-- Text Details Container -->
<LinearLayout
    android:layout_width="0dp"
    android:layout_weight="4"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"> <!-- Add padding to separate text from image -->

    <!-- Doctor Name -->
    <TextView
        android:id="@+id/doctorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dr. John Doe"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary_color" <!-- Primary color for emphasis -->
    android:fontFamily="sans-serif" />

    <!-- Specialization -->
    <TextView
        android:id="@+id/spacalist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cardiologist"
        android:textSize="14sp"
        android:textColor="@color/secondary_text_color" <!-- Secondary text color -->
    android:fontFamily="sans-serif"
    android:layout_marginTop="4dp" />


    <TextView
        android:id="@+id/doctordesignation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Senior Consultant"
        android:textSize="12sp"
        android:textColor="@color/secondary_text_color"
        android:fontFamily="sans-serif"
        android:layout_marginTop="4dp" />


    <TextView
        android:id="@+id/doctorcember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5 years of experience"
        android:textSize="12sp"
        android:textColor="@color/secondary_text_color"
        android:fontFamily="sans-serif"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/doctorvisitingtime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Visiting Hours: 9 AM - 5 PM"
        android:textSize="12sp"
        android:textColor="@color/secondary_text_color"
        android:fontFamily="sans-serif"
        android:layout_marginTop="4dp" />
</LinearLayout>
</LinearLayout>
    </androidx.cardview.widget.CardView>
    </LinearLayout>