            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/eiin"
            android:text=""
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:fontFamily="monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>


</LinearLayout>